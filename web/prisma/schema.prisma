// Career-management system — walking skeleton schema.
// Scope: access-control (roles + grants), org tree, people.
// Later phases add plans, progress, evaluations, gaps, and the agent half.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One thing a user did, for the Admin to investigate with.
///
/// `actorName` and `description` are SNAPSHOTS, deliberately denormalised: a log
/// that re-rendered itself from live rows would say "מחק את (נמחק)" precisely in
/// the case an investigation is about, and would silently rewrite its own
/// history when someone is renamed. The value of an entry is what was true when
/// it was written.
///
/// `subjectId` carries NO foreign key for the same reason — the most
/// interesting entries point at rows that no longer exist, and a real FK would
/// either block the deletion or cascade the evidence away.
model ActivityLog {
  id          String   @id @default(cuid())
  actorId     String // no FK: an entry outlives the account that made it
  actorName   String // as it read at the time
  action      String // "person.delete", "grant.add", …
  description String // one Hebrew sentence, composed at the moment of the act
  subjectType String? // "person" | "plan" | "org" | "user" | …
  subjectId   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

// Generic system settings (branding etc.) — key/value, admin-managed.
model AppSetting {
  key   String @id
  value String
}

enum Role {
  ADMIN // מנהלן = אדמין: users/grants, plan templates, person-card schema
  MANAGER // מנהל: operational, at VIEW or EDIT level
  HR // משא״ן: operational like a manager, and a lateral correspondent on the query page
}

enum AccessLevel {
  VIEW // read-only
  EDIT // read + manual data entry
}

enum OrgKind {
  CENTER // מרכז
  DOMAIN // תחום
  SECTION // מדור
  TEAM // צוות
}

enum EmploymentStatus {
  ACTIVE
  PLANNED_END
  DEPARTED
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  username         String?       @unique // derived from the email prefix (before @)
  passwordHash     String? // real auth is deferred (task 0.2); stored hashed as a placeholder
  role             Role
  grants           AccessGrant[]
  // The framework this user commands, if any. `@unique` on a NULLABLE column is
  // the whole enforcement: Postgres treats NULLs as distinct, so any number of
  // users may command nothing while a given framework can be claimed only once.
  // onDelete: SetNull — deleting a framework releases the command; it must never
  // delete the person who commanded it.
  commandsNode     OrgNode?      @relation("FrameworkCommander", fields: [commandsNodeId], references: [id], onDelete: SetNull)
  commandsNodeId   String?       @unique
  authoredQueries  Query[]       @relation("QueryAuthor")
  queryAnswers     QueryTarget[] @relation("QueryAnswerer")
  agentRuns        AgentRun[]
  rules            Rule[]
  createdAt        DateTime      @default(now())
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// One agent execution (a chat question or a rule run). Output is the rendered document.
model AgentRun {
  id         String         @id @default(cuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  kind       String // "CHAT" | "RULE" | "PIN" | "EXTRACT"
  rule       Rule?          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId     String?
  person     Person?        @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId   String? // extraction target; null for a new-person extraction
  prompt     String
  output     String?
  error      String?
  status     AgentRunStatus @default(RUNNING)
  pinnedRun  Boolean        @default(false) // executed via a pinned realization
  durationMs Int?
  createdAt  DateTime       @default(now())
}

enum RuleSchedule {
  NONE // on-demand only
  DAILY
  WEEKLY
  MONTHLY
}

enum RealizationKind {
  SCRIPT // deterministic Node script — reproduces the golden output 1:1 from data
  FLOW // locked procedure + format template the LLM must follow
}

// A user's verbal rule (דף חוקים). Private to its owner — even from superiors/admin.
model Rule {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  text      String // the verbal rule
  schedule  RuleSchedule @default(NONE)
  nextRunAt DateTime? // when the next chronic run is due
  /// Mail each run's output to the rule's OWNER — the only address consistent
  /// with a rules page that is private even from the Admin. Default false, so
  /// no rule that predates the field starts emailing without being asked.
  emailOnRun Boolean  @default(false)
  // Pinning ("deterministic" = fidelity to the approved output, not necessarily no-LLM)
  pinnedAt        DateTime?
  realizationKind RealizationKind?
  realization     String? // script source or locked-flow instructions
  goldenOutput    String? // the user-approved output (imitation template + sanity reference)
  runs      AgentRun[]
  createdAt DateTime     @default(now())
}

// An access grant = (org node, level). A user may hold several; effective
// visibility is the union of the subtrees rooted at the granted nodes.
model AccessGrant {
  id     String      @id @default(cuid())
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  node   OrgNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId String
  level  AccessLevel

  @@unique([userId, nodeId])
}

/// Who a query came from: a framework acting down the chain, or a person
/// (משא״ן) acting laterally inside the subtree they are granted over.
enum QuerySenderKind {
  FRAMEWORK
  STAFF
}

/// A question one commander puts to the commanders exactly one level below.
///
/// Anchored to FRAMEWORKS at both ends, not to people. The requirement that a
/// target framework with no commander still shows up as a row nobody can fill
/// settles it: a query that can be addressed to an empty framework is addressed
/// to the framework. `authorId` is credit, not ownership — replacing a commander
/// must never orphan a query, on either end.
///
/// There is no `closed` flag on purpose. Whether a query is open is derived from
/// `dueDate`, which the sender may move at any time; a stored flag would need an
/// unlock path, a re-lock path, and would drift on every edit.
model Query {
  id           String        @id @default(cuid())
  /// Which kind of correspondent asked. Written when the query is created and
  /// never inferred from the author's role afterwards: a role can change, and a
  /// correspondence must not quietly change hands when it does.
  senderKind   QuerySenderKind @default(FRAMEWORK)
  /// the framework that asked — deleting it takes its queries with it.
  /// For a STAFF query this is the SCOPE the request was made under, never the
  /// sender: it records which subtree bounded the reach. The from-line for such
  /// a query names the person, and must never render this.
  sender       OrgNode       @relation("QuerySender", fields: [senderNodeId], references: [id], onDelete: Cascade)
  senderNodeId String
  /// who actually wrote it; deleting the user leaves the query readable
  author       User?         @relation("QueryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId     String?
  title        String
  body         String
  dueDate      DateTime
  createdAt    DateTime      @default(now())
  /// set when the deadline is moved, so receivers can see that it changed
  dueChangedAt DateTime?
  /// the sender ended it early — before the deadline, answers or no answers
  closedAt     DateTime?
  targets      QueryTarget[]
}

/// One row per addressed framework — created whether or not anyone commands it.
model QueryTarget {
  id           String    @id @default(cuid())
  query        Query     @relation(fields: [queryId], references: [id], onDelete: Cascade)
  queryId      String
  node         OrgNode   @relation("QueryTargetNode", fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId       String
  answer       String? // null = has not responded
  /// who wrote the answer; deleting them leaves the answer text intact
  answeredBy   User?     @relation("QueryAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredById String?
  answeredAt   DateTime? // first answer
  updatedAt    DateTime? // last revision — absent when never revised
  remindedAt   DateTime?
  /// Has the SENDER seen this answer yet? Set false by every answer and every
  /// revision, and true when the sender next opens the page. This is what the
  /// header badge counts on the asking side — "new since I looked" is a fact
  /// about the reader, and cannot be derived from the answer's timestamps.
  seenBySender Boolean   @default(false)
  /// outcome of the last mail to this framework. Delivery happens after the
  /// response, so the sender is not watching; a failure has to be kept to be seen.
  mailOk       Boolean?
  mailError    String?

  @@unique([queryId, nodeId])
}

// Strict tree: CENTER > DOMAIN > SECTION > TEAM. People attach to TEAM nodes.
model OrgNode {
  id       String        @id @default(cuid())
  name     String
  kind     OrgKind
  parent   OrgNode?      @relation("OrgTree", fields: [parentId], references: [id])
  parentId String?
  children OrgNode[]     @relation("OrgTree")
  people    Person[]
  grants    AccessGrant[]
  commander User?         @relation("FrameworkCommander")
  sentQueries    Query[]       @relation("QuerySender")
  queryTargets   QueryTarget[] @relation("QueryTargetNode")
}

// --- Career plans (templates, relative to unit placement). Admin-authored. ---

model CareerPlan {
  id                String             @id @default(cuid())
  name              String
  isTemplate        Boolean            @default(true) // false = a per-person assigned copy
  createdAt         DateTime           @default(now())
  pointEvents       PointEvent[]
  cumulativeMetrics CumulativeMetric[]
  recurringEvents   RecurringEvent[]
  assignedTo        Person[]           @relation("AssignedPlan")
  // A per-person copy points back to the template it was created from.
  sourceTemplateId  String?
  sourceTemplate    CareerPlan?        @relation("PlanCopies", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies            CareerPlan[]       @relation("PlanCopies")
  // A copy is the subject of exactly one assignment; templates have none.
  assignment        PlanAssignment?    @relation("AssignmentPlan")
}

/// A period during which a person was measured against one plan copy.
/// Assignments are never deleted: ending one is how a person leaves a plan, and
/// keeping it is what preserves their milestones, readings and evaluations —
/// those records are children of the copy's items and would cascade away with it.
model PlanAssignment {
  id                 String          @id @default(cuid())
  person             Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId           String
  plan               CareerPlan      @relation("AssignmentPlan", fields: [planId], references: [id], onDelete: Cascade)
  planId             String          @unique
  templateName       String // snapshot: readable history even if the template is later deleted
  assignedAt         DateTime        @default(now())
  endedAt            DateTime? // null = active; a person has at most one active assignment
  /// Months from UNIT PLACEMENT at the moment of assignment — the same axis the
  /// plan uses. Items at or before it are waived: they were never required of
  /// this person.
  waiverOffsetMonths Int             @default(0)
  reason             String? // why the person moved off the previous plan
  waivers            PlanWaiver[]
  carryOvers         PlanCarryOver[]

  @@index([personId, endedAt])
}

/// A deviation from the assignment's waiver line for one item. Only overrides
/// are stored, so the common case stores nothing.
model PlanWaiver {
  id               String          @id @default(cuid())
  assignment       PlanAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId     String
  /// exactly one of the three identifies the item
  pointEvent       PointEvent?     @relation(fields: [pointEventId], references: [id], onDelete: Cascade)
  pointEventId     String?
  checkpoint       MetricCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  checkpointId     String?
  recurringEvent   RecurringEvent? @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)
  recurringEventId String?
  /// with recurringEventId: a single occurrence rather than the whole event
  occurrenceOffset Int?
  /// true = waived although it falls after the line; false = required although it falls before
  waived           Boolean
}

enum CarryOverKind {
  METRIC // an accumulated value follows the person
  POINT // a milestone already completed is not demanded again
}

/// Provenance for something credited from a previous plan. The credit itself is
/// an ordinary PointProgress or MetricReading on the new copy; this row is what
/// lets the card say where it came from, instead of presenting carried work as
/// work done under the current plan.
model PlanCarryOver {
  id             String            @id @default(cuid())
  assignment     PlanAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId   String
  kind           CarryOverKind
  fromPlanName   String // snapshots, so the origin survives whatever happens upstream
  fromLabel      String
  toMetricId     String?
  toPointEventId String?
  value          Float? // METRIC
  originalDate   DateTime? // completion date, or the reading's as-of date
}

// One-time, binary milestone at a month offset from unit placement.
model PointEvent {
  id           String          @id @default(cuid())
  plan         CareerPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId       String
  label        String
  offsetMonths Int
  progress     PointProgress[]
  waivers      PlanWaiver[]
}

// A live accumulating measure (e.g. grant hours, grant money) with timed targets.
model CumulativeMetric {
  id          String             @id @default(cuid())
  color       String? // soft-palette color assigned at creation (stable)
  plan        CareerPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      String
  name        String
  unit        String
  checkpoints MetricCheckpoint[]
  readings    MetricReading[]
}

model MetricCheckpoint {
  id           String           @id @default(cuid())
  metric       CumulativeMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  metricId     String
  offsetMonths Int
  target       Float
  waivers      PlanWaiver[]
}

enum RecurringStopMode {
  UNTIL_OFFSET // stop at a relative month cap (the template's stand-in for "a specific date")
  END_OF_SERVICE // stop at the person's end of service
}

// Defined once; auto-unrolls every `intervalMonths` from unit placement.
/// How a recurring event is drawn on the diagram.
enum RecurringDisplay {
  MARKER // small coloured diamonds on the axis (default)
  CARD // a labelled card at EVERY occurrence, like a point event
}

model RecurringEvent {
  id               String            @id @default(cuid())
  plan             CareerPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId           String
  label            String
  intervalMonths   Int
  /// Months from unit placement of the FIRST occurrence; the cycle runs
  /// start, start+interval, … ≤ stop. Backfilled = intervalMonths, which is
  /// exactly the schedule events produced before the column existed.
  startOffsetMonths Int
  /// MARKER (default) or CARD — one event has one representation, never both.
  display          RecurringDisplay  @default(MARKER)
  stopMode         RecurringStopMode
  stopOffsetMonths Int? // required when stopMode = UNTIL_OFFSET
  color            String? // soft-palette color assigned at creation (stable)
  evalEntries      EvalEntry[]
  waivers          PlanWaiver[]
}

// --- Evaluations & events page (חוות דעת ואירועים) ---

// An entry on a person's evaluations page. Either free-form (recurringEventId null)
// or a structured slot filling a specific recurring occurrence (event + month offset).
/// What an entry is. A row with `recurringEventId` set is a plan occurrence and
/// is neither of these — that test stays where it is; `kind` splits what remains.
enum EvalEntryKind {
  FREE // an ad-hoc note: "attended conference X"
  INTERVIEW // an ad-hoc interview summary, which may carry an assessment
}

model EvalEntry {
  id               String          @id @default(cuid())
  person           Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId         String
  /// Defaults to FREE deliberately: a mislabelled free entry is visible and
  /// fixable, whereas defaulting to INTERVIEW would manufacture interviews.
  kind             EvalEntryKind   @default(FREE)
  title            String
  content          String? // textual body
  /// When the event HAPPENED, as against createdAt = when it was typed.
  /// Backfilled from createdAt, which is what the page already displayed as the
  /// event's date, so no entry changes meaning.
  eventDate        DateTime
  /// 1–5, INTERVIEW only. Optional: an unrated interview must carry no value
  /// rather than one nobody chose. Int, not an enum — it is an ordered scale a
  /// report will want to compare and sort. Meanings live in lib/eval-scale.ts.
  score            Int?
  recurringEvent   RecurringEvent? @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)
  recurringEventId String?
  occurrenceOffset Int? // months from unit placement; set together with recurringEventId
  attachments      Attachment[]
  createdAt        DateTime        @default(now())

  @@unique([personId, recurringEventId, occurrenceOffset])
}

model Attachment {
  id          String    @id @default(cuid())
  entry       EvalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String
  filename    String // original name shown to users
  storagePath String // relative path under the uploads dir
  mimeType    String
  size        Int
  createdAt   DateTime  @default(now())
}

model Person {
  id               String             @id @default(cuid())
  firstName        String             @default("")
  lastName         String             @default("")
  fullName         String // maintained = firstName + " " + lastName (display + sort + search)
  birthDate        DateTime? // required in forms; age is derived from it, never stored
  photoPath        String? // profile picture, relative path under uploads/
  recruitmentDate  DateTime // their history; NOT what plan offsets resolve through
  /// Placed in this unit. THE anchor that converts plan offsets to calendar
  /// dates: a plan describes a path here, so time served elsewhere must not be
  /// measured as though it had been served here. Backfilled = recruitmentDate.
  placementDate    DateTime
  status           EmploymentStatus   @default(ACTIVE)
  endOfServiceDate DateTime?
  team             OrgNode?           @relation(fields: [teamId], references: [id])
  teamId           String? // null = unassigned (e.g. after its framework was deleted)
  assignedPlan     CareerPlan?        @relation("AssignedPlan", fields: [assignedPlanId], references: [id])
  assignedPlanId   String? // the active assignment's copy; history lives in planAssignments
  planAssignments  PlanAssignment[]
  fieldValues      PersonFieldValue[]
  pointProgress    PointProgress[]
  metricReadings   MetricReading[]
  evalEntries      EvalEntry[]
  proposals        ExtractionProposal[]
  agentRuns        AgentRun[]
  createdAt        DateTime           @default(now())
}

// A pre-filled draft for creating a NEW person from a document. Nothing is
// persisted to the registry until the manager reviews the form and saves.
model PersonDraft {
  id        String   @id @default(cuid())
  createdBy String // user id
  values    Json // { "fullName": "...", "recruitmentDate": "...", "field:<defId>": "..." }
  createdAt DateTime @default(now())
}

// Field values the agent proposed from an uploaded document — awaiting per-field
// human approval. The agent never writes to the person directly.
model ExtractionProposal {
  id        String   @id @default(cuid())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  createdBy String // user id that ran the extraction
  items     Json // [{key,label,current,proposed,fieldDefId?}]
  createdAt DateTime @default(now())
}

// --- Admin-configurable person-card schema (extra fields beyond the core ones) ---

enum FieldType {
  TEXT
  DATE
  NUMBER
  ENUM
}

model PersonFieldDef {
  id       String             @id @default(cuid())
  key      String             @unique
  label    String
  type     FieldType
  required Boolean            @default(false)
  options  String[] // for ENUM
  order    Int                @default(0)
  values   PersonFieldValue[]
}

model PersonFieldValue {
  id         String         @id @default(cuid())
  person     Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId   String
  field      PersonFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  fieldDefId String
  value      String
  order      Int            @default(0)

  @@unique([personId, fieldDefId])
}

// --- Progress against the person's assigned plan copy ---

// Existence = the point event is done (with its completion date).
model PointProgress {
  id           String     @id @default(cuid())
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId     String
  pointEvent   PointEvent @relation(fields: [pointEventId], references: [id], onDelete: Cascade)
  pointEventId String
  doneOn       DateTime
  note         String? // e.g. which occurrence type was completed

  @@unique([personId, pointEventId])
}

// Current accumulated value of a cumulative metric, with an as-of date.
model MetricReading {
  id       String           @id @default(cuid())
  person   Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  metric   CumulativeMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  metricId String
  value    Float
  asOf     DateTime
  note     String? // e.g. which course/training earned the credit

  @@unique([personId, metricId])
}
