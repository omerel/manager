# Copy to .env and adjust.

# Local Postgres (docker: npm run db:up serves on port 5433)
DATABASE_URL="postgresql://manager:manager@localhost:5433/manager?schema=public"

# Server-side secret: session signing + at-rest encryption (generate: openssl rand -hex 32)
APP_SECRET="change-me"

# Where uploads (photos, documents, logo) are stored. Defaults to ./uploads in dev.
# In a container this must point at a mounted persistent volume, or uploads are
# lost when the pod is replaced.
# UPLOADS_DIR="/data/uploads"

# Optional, local development only: enables the header user-switcher (impersonation).
# Leave unset in any real deployment.
# DEV_USER_SWITCH="1"
