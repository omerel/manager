# ===== manager app — runtime environment (copy to app.env and fill) =====

# Managed Postgres connection (required)
DATABASE_URL="postgresql://USER:PASSWORD@db-host:5432/manager?schema=public"

# Server-side secret: session signing + at-rest encryption (required).
# Generate once (openssl rand -hex 32) and KEEP STABLE across upgrades —
# rotating it invalidates all sessions and encrypted values.
APP_SECRET="change-me"

# --- First-boot bootstrap (used ONLY when the user table is empty) ---
# Creates the first Admin so you can log in to an empty system.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong"
ADMIN_EMAIL="admin@example.org"

# --- Web ---
# The app listens on 0.0.0.0 (reachable from remote machines) — override with HOST/PORT.
# PORT=3000
# Hostnames the app is served through (OpenShift route / reverse proxy), for the
# Server-Action origin check. Comma-separated.
# ALLOWED_ORIGINS="manager.apps.mycluster.local"

# Note: the Claude CLI is baked into the image and agent subprocesses inherit the
# container environment automatically — if your CLI setup needs anything, provide
# it to the pod the same way you do elsewhere. Nothing to configure here.
# Optional: AGENT_MODEL="..." to pin the model used for agent runs.

# Never set DEV_USER_SWITCH in production.
